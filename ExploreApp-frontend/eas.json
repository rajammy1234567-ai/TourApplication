{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tourapplication-api.onrender.com",
        "EXPO_PUBLIC_FORCE_PROD_API": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tourapplication-api.onrender.com",
        "EXPO_PUBLIC_FORCE_PROD_API": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tourapplication-api.onrender.com",
        "EXPO_PUBLIC_FORCE_PROD_API": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
