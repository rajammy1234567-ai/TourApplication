# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/explore
JWT_SECRET_KEY=change_this_to_a_long_random_secret

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# Default seeded accounts (created on first boot if empty)
ADMIN_EMAIL=admin@explore.com
ADMIN_PASSWORD=admin123
VENDOR_PHONE=9876543210
VENDOR_PASSWORD=vendor123

# Payments (tour bookings). Leave empty + set ALLOW_DEMO_BOOKING=true for local demo without Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_DEMO_BOOKING=true

# Events API (optional — falls back to demo events)
TICKETMASTER_API_KEY=
# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=viztravel

